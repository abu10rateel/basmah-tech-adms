# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / FRONTEND_URL: The URL where this applet is hosted.
# Used for constructing password reset links in emails.
APP_URL="MY_APP_URL"
FRONTEND_URL=

# Gmail / Nodemailer SMTP Email Credentials
# EMAIL_USER: Your Gmail email address (e.g., example@gmail.com)
# EMAIL_PASS: Your Gmail App Password generated from Google Account Security (16 letters, e.g., abcd efgh ijkl mnop)
EMAIL_USER=
EMAIL_PASS=

# Optional custom SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME="بصمة تك - Basma Tech"

# Supabase Database Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

